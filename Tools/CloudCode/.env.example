# ============================================================
# UGS Cloud Code 배포 자격증명 템플릿
# 사용법: Copy-Item .env.example .env  후 값을 채운다 (이름 변경이 아니라 '복사')
# .env 는 .gitignore 대상이고 이 템플릿은 커밋 대상이다
# ============================================================

# Unity 프로젝트 ID (ProjectSettings/ProjectSettings.asset 의 cloudProjectId)
UNITY_PROJECT_ID=00000000-0000-0000-0000-000000000000

# 배포 대상 환경. 게임이 환경을 지정하지 않으므로 SDK 기본값과 같은 production 을 쓴다
UNITY_ENV_NAME=production

# Unity Cloud > Administration > Service Accounts 에서 발급
# 필요한 프로젝트 역할 3개 (하나라도 빠지면 403 Not authorized):
#   Cloud Code Editor           - 스크립트 조회/수정
#   Cloud Code Script Publisher - publish. Editor 에 포함되지 않는 별도 역할이다
#   Unity Environments Viewer   - 환경 이름 -> ID 조회
UGS_SERVICE_KEY_ID=your-service-account-key-id
UGS_SERVICE_SECRET_KEY=your-service-account-secret
