# ============================================================
# 어드민 사이트 환경변수 템플릿
# 사용법: Copy-Item .env.example .env  후 값을 채운다
# 자세한 발급 절차는 Documents/admin-site/setup.md 참고
# ============================================================

# --- 서버 ---
# Starlette 세션 쿠키 서명 키. 노출되면 세션 위조 가능.
# 생성 예: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-me-with-long-random-hex
PORT=8000
# OAuth redirect_uri 구성에 사용. 배포 시 https URL 로 교체
PUBLIC_BASE_URL=http://localhost:8000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# 허용 운영자 이메일 (콤마 구분). 비어 있으면 아무도 로그인 못 함
ADMIN_ALLOWED_EMAILS=admin@example.com

# --- Unity Services ---
UNITY_PROJECT_ID=00000000-0000-0000-0000-000000000000
UNITY_ENV_ID=00000000-0000-0000-0000-000000000000
UNITY_SERVICE_KEY_ID=your-service-account-key-id
UNITY_SERVICE_SECRET_KEY=your-service-account-secret
UNITY_LEADERBOARD_ID=final-days
